{
  "name": "claude-kurgu-atolyesi",
  "version": "1.0.0",
  "description": "Claude Code ile konuşan-kafa YouTube videolarını kodla kurgulama atölyesi (Remotion + FFmpeg)",
  "repository": {},
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@remotion/bundler": "4.0.526",
    "@remotion/cli": "4.0.526",
    "@remotion/google-fonts": "4.0.526",
    "@remotion/media": "4.0.526",
    "@remotion/renderer": "4.0.526",
    "@remotion/tailwind-v4": "4.0.526",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.526",
    "tailwindcss": "4.0.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@fontsource/geist": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@playwright/test": "1.61.1",
    "@remotion/eslint-config-flat": "4.0.526",
    "@remotion/fonts": "4.0.526",
    "@remotion/player": "4.0.526",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "d3-geo": "^3.1.1",
    "esbuild": "0.28.1",
    "eslint": "9.19.0",
    "lucide-static": "0.460.0",
    "prettier": "3.8.1",
    "topojson-client": "^3.1.0",
    "typescript": "5.9.3",
    "world-atlas": "^2.0.2"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "lint:node": "eslint -c eslint.node.config.mjs scripts studio tests",
    "probe": "node scripts/00-probe.mjs",
    "restore": "node scripts/92-restore.mjs",
    "proxy": "node scripts/10-proxy.mjs",
    "transcribe": "node scripts/20-transcribe.mjs && node scripts/21-review-transcript.mjs",
    "transcribe:check": "node scripts/22-check-hallucinations.mjs",
    "gaps": "node scripts/23-gap-report.mjs",
    "denoise:preview": "node scripts/76-denoise-preview.mjs",
    "privacy": "node scripts/85-privacy.mjs",
    "assets": "node scripts/30-normalize-assets.mjs",
    "luts": "node scripts/40-make-luts.mjs",
    "plan:check": "node scripts/50-validate-plan.mjs",
    "render:gfx": "node scripts/50-validate-plan.mjs && node scripts/60-render-segments.mjs",
    "stills": "node scripts/65-design-stills.mjs",
    "composite:draft": "node scripts/70-composite.mjs --draft",
    "composite": "node scripts/70-composite.mjs",
    "qc:draft": "node scripts/80-qc.mjs --file work/composite/draft-hlg.mov --stills",
    "qc": "node scripts/80-qc.mjs --file work/composite/final-hlg.candidate.mov --stills --promote --promote-to out/final-hlg.temiz-ses.mov",
    "audio": "node scripts/lib/synth.mjs && node scripts/75-audio.mjs --mux",
    "qc:mix": "node scripts/80-qc.mjs --file work/composite/final-hlg.mix.candidate.mov --audio mix --clean out/final-hlg.temiz-ses.mov --skip-decode --promote",
    "master:detached": "node scripts/run-master-detached.mjs",
    "deliver:detached": "node scripts/run-delivery-detached.mjs",
    "studio": "node studio/server.mjs",
    "master": "npm run render:gfx && npm run composite && npm run qc && npm run audio && npm run qc:mix",
    "shorts": "node scripts/90-shorts.mjs",
    "test:studio": "node scripts/vendor-fonts.mjs && node --test --test-concurrency=1 --test-timeout=1800000 studio/tests/studio.test.mjs",
    "docs:screenshots": "node scripts/docs-screenshots.mjs",
    "test:unit": "node --test tests/unit.test.mjs tests/scripts.test.mjs tests/timeline.test.mjs tests/montage.test.mjs tests/assemble.test.mjs tests/privacy.test.mjs",
    "thumbnail": "node scripts/95-thumbnail.mjs",
    "cleanup": "node scripts/cleanup.mjs",
    "test:ui": "node scripts/ui-smoke.mjs",
    "test:assemble": "node --test tests/assemble.test.mjs"
  },
  "sideEffects": [
    "*.css"
  ]
}
